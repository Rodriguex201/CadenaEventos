<Window x:Class="EventoMercantiles.Views.DatosEmpresaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventoMercantiles.Views"
        mc:Ignorable="d"
        Title="DatosEmpresaView" Height="410" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" KeyUp="ViewActivacion">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="DATOS EMPRESA" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="30" Margin="285,4,0,0" />
        <Label Content="serial" x:Name="lbserial" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Height="25" Grid.Row="0" VerticalAlignment="Bottom" Width="200"/>
        <Grid RenderTransformOrigin="0.5,0.398" Margin="0,59,0,0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,10,95" Background="Bisque" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Label Content="Token" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtToken" Grid.Row="0"  Margin="50,10,10,2"/>
                <Label Content="URL" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="txturl" Text="https://alfaprod.dominadigital.com.co/api/ReceptorEventoJson/" IsEnabled="False" Grid.Row="1"  Margin="50,10,10,2"/>
                <Label Content="NIT" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="txtnit" Grid.Row="2"  Margin="50,10,10,0"/>
                <Label Content="NOMBRE" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0" Width="61" Height="28"/>
                <TextBox x:Name="txtnombre" Grid.Row="3"  Margin="63,10,10,0"/>
                <Label Content="NOMBRE2" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0" Width="66" Height="28"/>
                <TextBox x:Name="txtnombre2" Grid.Row="4"  Margin="64,10,10,0"/>
            </Grid>
            <Grid Grid.Row="1" Margin="10,15,10,-15" Background="LightBlue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <Label Content="ip" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0" Height="26" Width="20"/>
                <TextBox x:Name="txtip" Grid.Row="0"  Margin="50,7,10,5"/>
                <Label Content="Codigo" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,10,0,0" Grid.RowSpan="2" Height="26" Width="48"/>
                <TextBox x:Name="txtcode" Grid.Row="1"  Margin="0,12,10,0" HorizontalAlignment="Right" Width="704"/>
                <Label Content="Mac" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,10,0,0" Grid.RowSpan="2" Height="26" Width="47"/>
                <TextBox x:Name="txtmac" Grid.Row="2"  Margin="50,12,10,5"/>
            </Grid>
            <Button Content="Guardar" Click="Button_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,13,-54" Width="60" Height="30" Grid.Row="1"/>
            <Button Content="Actualizar db" x:Name="actualizardb"  Click="Actualizardb_Click" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,-53" Width="105" Height="30" Grid.Row="1"/>

        </Grid>
    </Grid>
</Window>
