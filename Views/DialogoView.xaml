<Window x:Class="EventoMercantiles.Views.DialogoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventoMercantiles.Views"
        mc:Ignorable="d"
        Title="DialogoView" Height="180" Width="200" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <Border Margin="10" BorderBrush="Red" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Clave" FontWeight="Bold" HorizontalContentAlignment="Center"/>
            <PasswordBox x:Name="txtclave"  Height="20" Grid.Row="1" Margin="5,8,5,8"/>
            <Button Content="Aceptar" x:Name="Btnclave" Click="Btnclave_Click" Grid.Row="2" Margin="10,0,10,0"/>
        </Grid>
    </Border>
</Window>
